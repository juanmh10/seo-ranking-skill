# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json

# User-owned inputs and agent-generated artifacts
input/*
!input/.gitkeep
output/*
!output/.gitkeep
deprecated/*
!deprecated/.gitkeep
trash/*
!trash/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyd
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Node / frontend
node_modules/
.vite/
.playwright-cli/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases and runtime state
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
logs/
.cache/
tmp/
temp/

# Cloud infrastructure and local Terraform state are intentionally not versioned
infra/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*:Zone.Identifier
